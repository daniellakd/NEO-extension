{
  "name": "neo-vscode",
  "displayName": "NEO",
  "description": "Chat with the local NEO orchestrator from VS Code. A thin client: the pipeline, gates and checks stay in NEO. Powered by CodeValue.",
  "version": "0.1.0",
  "publisher": "neoag",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "neo",
          "title": "NEO",
          "icon": "media/neo.svg"
        }
      ]
    },
    "views": {
      "neo": [
        {
          "type": "webview",
          "id": "neo.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "neo.connect",
        "title": "Connect",
        "category": "NEO",
        "icon": "$(plug)"
      },
      {
        "command": "neo.refresh",
        "title": "Refresh",
        "category": "NEO",
        "icon": "$(refresh)"
      },
      {
        "command": "neo.newProject",
        "title": "New Project",
        "category": "NEO",
        "icon": "$(add)"
      },
      {
        "command": "neo.openInBrowser",
        "title": "Open Web UI",
        "category": "NEO",
        "icon": "$(link-external)"
      },
      {
        "command": "neo.switchProject",
        "title": "Projects",
        "category": "NEO",
        "icon": "$(list-selection)"
      },
      {
        "command": "neo.sessions",
        "title": "Sessions",
        "category": "NEO",
        "icon": "$(history)"
      },
      {
        "command": "neo.startSession",
        "title": "Start New Session",
        "category": "NEO",
        "icon": "$(add)"
      },
      {
        "command": "neo.stop",
        "title": "Stop Current Work",
        "category": "NEO",
        "icon": "$(debug-stop)"
      },
      {
        "command": "neo.goTo",
        "title": "Go to…",
        "category": "NEO"
      },
      {
        "command": "neo.openDesign",
        "title": "Open Design",
        "category": "NEO"
      },
      {
        "command": "neo.openPlan",
        "title": "Open Plan",
        "category": "NEO"
      },
      {
        "command": "neo.openChanges",
        "title": "Open Current Changes",
        "category": "NEO"
      },
      {
        "command": "neo.openSettings",
        "title": "Open NEO Settings",
        "category": "NEO",
        "icon": "$(gear)"
      },
      {
        "command": "neo.addContext",
        "title": "Add Context to Message…",
        "category": "NEO"
      },
      {
        "command": "neo.addCurrentFile",
        "title": "Add Current File to Message",
        "category": "NEO"
      },
      {
        "command": "neo.addSelection",
        "title": "Add Selection to Message",
        "category": "NEO"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "neo.addSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "neo@1"
        }
      ],
      "view/title": [
        {
          "command": "neo.stop",
          "when": "view == neo.chat && neo.busy",
          "group": "navigation@1"
        },
        {
          "command": "neo.startSession",
          "when": "view == neo.chat && neo.sessionDone",
          "group": "navigation@2"
        },
        {
          "command": "neo.newProject",
          "when": "view == neo.chat && !neo.hasProject",
          "group": "navigation@3"
        },
        {
          "command": "neo.sessions",
          "when": "view == neo.chat && neo.hasProject",
          "group": "navigation@4"
        },
        {
          "command": "neo.switchProject",
          "when": "view == neo.chat",
          "group": "navigation@5"
        },
        {
          "command": "neo.goTo",
          "when": "view == neo.chat",
          "group": "1_navigate@1"
        },
        {
          "command": "neo.openDesign",
          "when": "view == neo.chat",
          "group": "1_navigate@2"
        },
        {
          "command": "neo.openPlan",
          "when": "view == neo.chat",
          "group": "1_navigate@3"
        },
        {
          "command": "neo.openChanges",
          "when": "view == neo.chat",
          "group": "1_navigate@4"
        },
        {
          "command": "neo.refresh",
          "when": "view == neo.chat",
          "group": "2_project@1"
        },
        {
          "command": "neo.openInBrowser",
          "when": "view == neo.chat",
          "group": "2_project@2"
        },
        {
          "command": "neo.newProject",
          "when": "view == neo.chat && neo.hasProject",
          "group": "2_project@3"
        },
        {
          "command": "neo.connect",
          "when": "view == neo.chat",
          "group": "3_neo@1"
        },
        {
          "command": "neo.openSettings",
          "when": "view == neo.chat",
          "group": "3_neo@2"
        }
      ]
    },
    "configuration": {
      "title": "NEO",
      "properties": {
        "neo.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8720",
          "markdownDescription": "Base URL of the running NEO server, e.g. `http://127.0.0.1:8720`. The extension never starts NEO: start it separately, then use **NEO: Connect** (or Retry in the sidebar)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test \"out/test/**/*.test.js\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.90.0",
    "typescript": "~5.6.3"
  }
}
